# ============ AMD vLLM endpoint (your AMD Developer Cloud droplet) ============
# Leave VLLM_BASE_URL empty to run the offline demo reasoner (no GPU needed).
VLLM_BASE_URL=http://<droplet-ip>:8000/v1
VLLM_API_KEY=change-me
VLLM_MODEL=factorypilot-vl
HARDWARE_LABEL=AMD Instinct MI300X · ROCm · vLLM

# ============ Evolus (event workspace at app.evolus.ai) ============
# API key + application id from the workspace settings. Never commit real values.
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_CHAT_BASE_URL=https://api.evolus.ai/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
# Building block 1: knowledge library holding the equipment manuals (data/manuals/*.md)
EVOLUS_MANUALS_LIBRARY_ID=
# Building block 2: workflow that receives the work order and routes it to a technician
EVOLUS_WORKORDER_WORKFLOW_ID=
# Building block 3 (optional): Evolus agent/model id for the copilot, wired to the AMD endpoint above
EVOLUS_CHAT_MODEL=
# Route templates — confirm against the API reference in your workspace
EVOLUS_PATH_RUN_WORKFLOW=/workflows/{workflow_id}/run
EVOLUS_PATH_SEARCH_LIBRARY=/knowledge-libraries/{library_id}/search

# ============ Behaviour ============
# auto = use AMD when VLLM_BASE_URL is set; demo = force offline reasoner
LLM_BACKEND=auto
CONFIDENCE_FLOOR=0.6
# Seconds of wall time per simulated sensor sample on the Floor view (lower = faster drift)
SIM_SECONDS_PER_SAMPLE=3
# 1 = fully offline with no network calls at all (tests)
MOCK_MODE=0
